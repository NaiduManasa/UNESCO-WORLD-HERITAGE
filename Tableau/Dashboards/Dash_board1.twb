      <aliases enabled='yes' />
      <column caption='Danger Status' datatype='string' name='[Calculation_2247014764204425218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [danger] = 1 THEN &quot;In Danger&quot; ELSE &quot;Not in Danger&quot; END' />
      </column>
      <column caption='year_forecast' datatype='date' name='[Calculation_2247014764205584387]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE([date_inscribed], 1, 1)' />
      </column>
      <column caption='Log Country Count' datatype='real' name='[Calculation_2247014764230934533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG(COUNTD([states_name_en]))' />
      </column>
      <column caption='Top 10 by Area' datatype='boolean' name='[Calculation_2247014764256133127]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([area_hectares])) &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 10 Countries by Area' datatype='boolean' name='[Calculation_2247014764256948232]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([area_hectares])) &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1 year end' datatype='date' name='[Calculation_2247014764396498958]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE([date_end], 1, 1)' />
      </column>
      <column caption='Heritage Ended' datatype='boolean' name='[Calculation_2247014764397871119]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([date_end]) = FALSE' />
      </column>
